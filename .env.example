# Copy to .env.local and adjust. Never commit real secrets.

# PostgreSQL (docker compose exposes port 5433 on the host)
DATABASE_URL="postgresql://restaurant:restaurant_dev_password@localhost:5433/restaurant?schema=public"
# Used by `npm test` (integration tests reset this database!)
TEST_DATABASE_URL="postgresql://restaurant:restaurant_dev_password@localhost:5433/restaurant_test?schema=public"
# Used by `npm run test:e2e` (reset and re-seeded on every e2e run)
E2E_DATABASE_URL="postgresql://restaurant:restaurant_dev_password@localhost:5433/restaurant_e2e?schema=public"

# Public base URL used inside table QR codes. Use your LAN IP (e.g. http://192.168.1.20:3000)
# so a phone on the same Wi-Fi can open the QR link.
APP_BASE_URL="http://localhost:3000"

# 32+ random characters. Used to derive hashes for rate-limit keys and OTP codes.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET="change-me-to-a-long-random-string-of-at-least-32-chars"

# Phone OTP: "dev" shows the code on screen (clearly labelled, development only),
# "disabled" turns verification off, "provider" requires an SMS provider integration.
OTP_MODE="dev"

# Demo accounts (seeded with isDemo=true) are refused at login in production unless this is "true".
ALLOW_DEMO_ACCOUNTS="false"

# Background outbox dispatcher interval (ms). Set to 0 to disable the in-process worker.
OUTBOX_POLL_INTERVAL_MS="3000"

# Directory for uploaded menu images (outside /public so uploads are served through a validated route).
UPLOAD_DIR="./uploads"

# Optional: trust X-Forwarded-For from your reverse proxy for rate limiting.
TRUST_PROXY="false"
